@page
@model RXERP.Pages.HRMModel
@{
    ViewData["Title"] = "Human Resource Management";
}

<div class="container">
    <div class="row align-items-center mb-3">
        <div class="col">
            <h1 class="h3">Human Resource Management</h1>
        </div>
    </div>

    <!-- Summary cards -->
    <section class="d-flex flex-wrap gap-3 mb-4" aria-label="Key Metrics">
        <div class="card p-3" style="min-width:180px;">
            <div class="h4 mb-0">@Model.TotalEmployees</div>
            <small class="text-muted">Employees</small>
        </div>
        <div class="card p-3" style="min-width:180px;">
            <div class="h4 mb-0">@Model.DepartmentCount</div>
            <small class="text-muted">Departments</small>
        </div>
        <div class="card p-3" style="min-width:180px;">
            <div class="h4 mb-0">@Model.AvgSalary.ToString("C0")</div>
            <small class="text-muted">Avg Salary</small>
        </div>
        <div class="card p-3" style="min-width:180px;">
            <div class="h4 mb-0">@Model.MonthlyPayroll.ToString("C0")</div>
            <small class="text-muted">Monthly Payroll</small>
        </div>
    </section>

    <!-- Toolbar: filter by department -->
    <section class="card mb-4 p-3">
        <form method="post" asp-page-handler="Filter" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="deptSelect" class="form-label">Select Department</label>
                <select id="deptSelect" name="SelectedDepartment" asp-for="SelectedDepartment" class="form-select" aria-label="Department filter">
                    <option value="All" selected>All</option>
                    @{
                        var depts = (Model.Employees ?? Enumerable.Empty<dynamic>())
                            .Select(e => Convert.ToString(e.Department))
                            .Where(s => !string.IsNullOrWhiteSpace(s))
                            .OrderBy(s => s)
                            .ToList();
                    }
                    @foreach (var d in depts)
                    {
                        <option value="@d" selected="@(string.Equals(Model.SelectedDepartment, d, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@d</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-outline-secondary" onclick="location.href='@Url.Page("/HRM")'">Reset</button>
            </div>
        </form>
    </section>

    <!-- Add / Edit Employee form -->
    <section class="card mb-4 p-3">
        <h5 class="mb-3">@((Model.Input.Employee_ID == 0) ? "Register Employee" : $"Edit Employee #{Model.Input.Employee_ID}")</h5>

        <form method="post" asp-page-handler="Save" class="row g-3 needs-validation" novalidate>
            <input asp-for="Input.Employee_ID" type="hidden" />
            <div class="col-md-3">
                <label asp-for="Input.Last_Name" class="form-label">Last Name</label>
                <input asp-for="Input.Last_Name" class="form-control" placeholder="Enter last name" />
                <span asp-validation-for="Input.Last_Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.First_Name" class="form-label">First Name</label>
                <input asp-for="Input.First_Name" class="form-control" placeholder="Enter first name" />
                <span asp-validation-for="Input.First_Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Department" class="form-label">Department</label>
                <input asp-for="Input.Department" class="form-control" placeholder="e.g., HR, Finance, IT" />
                <span asp-validation-for="Input.Department" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Role" class="form-label">Role</label>
                <input asp-for="Input.Role" class="form-control" placeholder="Job title or role" />
                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="name@company.example" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Phone" class="form-label">Phone</label>
                <input asp-for="Input.Phone" class="form-control" placeholder="555-012-3456" />
                <span asp-validation-for="Input.Phone" class="text-danger"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="Input.Address" class="form-label">Address</label>
                <input asp-for="Input.Address" class="form-control" placeholder="Street, City, State" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="Input.Salary" class="form-label">Salary</label>
                <input asp-for="Input.Salary" type="number" step="0.01" min="0" class="form-control" placeholder="Annual salary" />
                <span asp-validation-for="Input.Salary" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">@((Model.Input.Employee_ID == 0) ? "Register" : "Save Changes")</button>
                <a asp-page="./HRM" class="btn btn-secondary ms-2">New</a>
            </div>
        </form>

        <div asp-validation-summary="All" class="text-danger mt-2"></div>
    </section>

    <!-- Employee Directory table -->
    <section>
        <h5>Employee Directory</h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Last Name</th>
                        <th>First Name</th>
                        <th>Department</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Role</th>
                        <th class="text-end">Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Employees == null || !Model.Employees.Any())
                    {
                        <tr><td colspan="10" class="text-center">No employees found.</td></tr>
                    }
                    else
                    {
                        foreach (var e in Model.Employees)
                        {
                            <tr>
                                <td>@e.Employee_ID</td>
                                <td>@e.Last_Name</td>
                                <td>@e.First_Name</td>
                                <td>@e.Department</td>
                                <td>@e.Email</td>
                                <td>@e.Phone</td>
                                <td>@e.Address</td>
                                <td>@e.Role</td>
                                <td class="text-end">@e.Salary.ToString("C0")</td>
                                <td class="text-nowrap">
                                    <a asp-page="./HRM" asp-route-editId="@e.Employee_ID" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form method="post" asp-page-handler="Delete" class="d-inline-block ms-1" onsubmit="return confirm('Delete employee @e.First_Name @e.Last_Name?');">
                                        <input type="hidden" name="id" value="@e.Employee_ID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}