@page
@model RXERP.Pages.InventorymgmtModel
@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container my-4">
    <h2>Inventory Management</h2>

    <!-- Cards -->
    <div class="row g-3 my-3">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <h6>Items</h6>
                    <h3>@Model.TotalItemsCount</h3>
                    <small class="text-muted">Total inventory SKUs</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6>Inventory Value</h6>
                    <h3>@Model.TotalInventoryValue.ToString("C")</h3>
                    <small class="text-muted">Estimated on-hand value</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <h6>Low Stock</h6>
                    <h3>@Model.LowStockCount</h3>
                    <small class="text-muted">At or below reorder level</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6>Top Qty</h6>
                    <h3>@(Model.TopItemByQty != null ? Model.TopItemByQty.Qty_On_Hand.ToString("0.##") : "-")</h3>
                    <small class="text-muted">@Model.TopItemByQty?.Name</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter toolbar -->
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label">Category</label>
            <select name="CategoryFilter" class="form-select">
                <option value="">All</option>
                @foreach (var c in Model.Categories)
                {
                    if (c == Model.CategoryFilter)
                    {
                        <option value="@c" selected>@c</option>
                    }
                    else
                    {
                        <option value="@c">@c</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">Search</label>
            <input name="Search" class="form-control" value="@Model.Search" placeholder="name or sku" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">Apply</button>
            <a class="btn btn-outline-secondary" href="@Url.Page(null, new { CategoryFilter = (string?)null, Search = (string?)null })">Reset</a>
        </div>

        <div class="col text-end">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addModal">Add Item</button>
        </div>
    </form>

    <!-- Inventory table -->
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>SKU</th><th>Name</th><th>Category</th><th>Qty</th><th>Unit Cost</th><th>Unit Price</th><th>Reorder</th><th>Location</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in Model.Items)
            {
                <tr>
                    <td>@it.SKU</td>
                    <td>@it.Name</td>
                    <td>@it.Category</td>
                    <td>@it.Qty_On_Hand.ToString("0.##")</td>
                    <td>@it.Unit_Cost.ToString("C")</td>
                    <td>@it.Unit_Price.ToString("C")</td>
                    <td>@(it.Reorder_Level?.ToString("0.##") ?? "-")</td>
                    <td>@it.Location</td>
                    <td>
                        <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@it.Item_ID">Edit</button>
                        <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@it.Item_ID">Delete</button>
                    </td>
                </tr>

                <!-- Edit Modal -->
                <div class="modal fade" id="editModal-@it.Item_ID" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <form method="post" asp-page-handler="Edit">
                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Item - @it.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="id" value="@it.Item_ID" />
                                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label">SKU</label>
                                            <input name="Input.SKU" class="form-control" value="@it.SKU" required />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label">Name</label>
                                            <input name="Input.Name" class="form-control" value="@it.Name" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Category</label>
                                            <input name="Input.Category" class="form-control" value="@it.Category" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Qty</label>
                                            <input name="Input.Qty_On_Hand" type="number" step="0.01" class="form-control" value="@it.Qty_On_Hand" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Reorder Level</label>
                                            <input name="Input.Reorder_Level" type="number" step="0.01" class="form-control" value="@(it.Reorder_Level?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Unit Cost</label>
                                            <input name="Input.Unit_Cost" type="number" step="0.0001" class="form-control" value="@it.Unit_Cost" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Unit Price</label>
                                            <input name="Input.Unit_Price" type="number" step="0.01" class="form-control" value="@it.Unit_Price" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Location</label>
                                            <input name="Input.Location" class="form-control" value="@it.Location" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Description</label>
                                            <textarea name="Input.Description" class="form-control">@it.Description</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal-@it.Item_ID" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="post" asp-page-handler="Delete">
                                <div class="modal-header">
                                    <h5 class="modal-title">Delete Item</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Are you sure you want to delete <strong>@it.Name</strong> (SKU: @it.SKU)?
                                    <input type="hidden" name="id" value="@it.Item_ID" />
                                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header">
                    <h5 class="modal-title">Add Inventory Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">SKU</label>
                            <input name="Input.SKU" class="form-control" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Name</label>
                            <input name="Input.Name" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <input name="Input.Category" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Qty</label>
                            <input name="Input.Qty_On_Hand" type="number" step="0.01" class="form-control" value="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Reorder Level</label>
                            <input name="Input.Reorder_Level" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit Cost</label>
                            <input name="Input.Unit_Cost" type="number" step="0.0001" class="form-control" value="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit Price</label>
                            <input name="Input.Unit_Price" type="number" step="0.01" class="form-control" value="0" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Location</label>
                            <input name="Input.Location" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea name="Input.Description" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add item</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ensure modals can open after postbacks if server returns Page with validation errors.
        (function () {
            // nothing special here; Bootstrap handles normal usage.
        })();
    </script>
}