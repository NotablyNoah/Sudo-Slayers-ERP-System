@page
@model RXERP.Pages.FinancialModel
@{
    ViewData["Title"] = "Financial";
}

<div class="container my-4">
    <h2>Financial Overview</h2>

    <div class="row g-3 my-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2">Invoices</h6>
                    <h3 class="card-title">@Model.InvoiceCount</h3>
                    <small class="text-muted">Total invoiced: @Model.TotalInvoiced.ToString("C")</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2">Payments</h6>
                    <h3 class="card-title">@Model.PaymentCount</h3>
                    <small class="text-muted">Total revenue: @Model.TotalRevenue.ToString("C")</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2">Outstanding</h6>
                    <h3 class="card-title">@Model.Outstanding.ToString("C")</h3>
                    <small class="text-muted">Invoices - Payments</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2">Vendors Owing</h6>
                    <h3 class="card-title">@Model.VendorsOwing.Count</h3>
                    <small class="text-muted">Vendors with outstanding balances</small>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Show table</label>
        <div class="btn-group" role="group" aria-label="tables">
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-invoices">Invoices</button>
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-invoicelines">Invoice Lines</button>
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-payments">Payments</button>
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-journals">Journals</button>
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-journallines">Journal Lines</button>
            <button type="button" class="btn btn-outline-secondary table-toggle" data-target="#table-vendorsowing">Vendors Owing</button>
        </div>
    </div>

    <!-- Tables (all hidden until selected) -->
    <div id="table-invoices" class="table-pane d-none">
        <h4>Invoices</h4>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Number</th>
                    <th>Date</th>
                    <th>Due</th>
                    <th>Vendor</th>
                    <th>Subtotal</th>
                    <th>Tax</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Deleted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Invoices)
                {
                    <tr>
                        <td>@i.Invoice_ID</td>
                        <td>@i.Invoice_Number</td>
                        <td>@i.Invoice_Date.ToString("yyyy-MM-dd")</td>
                        <td>@(i.Due_Date.HasValue ? i.Due_Date.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td>@i.Vendor_ID</td>
                        <td>@i.Subtotal.ToString("C")</td>
                        <td>@i.Tax_Amount.ToString("C")</td>
                        <td>@i.Total_Amount.ToString("C")</td>
                        <td>@i.Status</td>
                        <td>@i.Created_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@i.Updated_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(i.Deleted_At.HasValue ? i.Deleted_At.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="table-invoicelines" class="table-pane d-none">
        <h4>Invoice Lines</h4>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Line ID</th>
                    <th>Invoice ID</th>
                    <th>Line #</th>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                    <th>Tax</th>
                    <th>Line Total</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Deleted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.InvoiceLines)
                {
                    <tr>
                        <td>@l.Line_ID</td>
                        <td>@l.Invoice_ID</td>
                        <td>@l.Line_Number</td>
                        <td>@(string.IsNullOrEmpty(l.Item_Code) ? "" : l.Item_Code)</td>
                        <td>@l.Description</td>
                        <td>@l.Quantity.ToString("0.##")</td>
                        <td>@l.Unit_Price.ToString("C")</td>
                        <td>@l.Line_Subtotal.ToString("C")</td>
                        <td>@l.Tax_Amount.ToString("C")</td>
                        <td>@l.Line_Total.ToString("C")</td>
                        <td>@l.Created_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@l.Updated_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(l.Deleted_At.HasValue ? l.Deleted_At.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="table-payments" class="table-pane d-none">
        <h4>Payments</h4>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Vendor</th>
                    <th>Method</th>
                    <th>Reference</th>
                    <th>Amount</th>
                    <th>Notes</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Deleted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td>@p.Payment_ID</td>
                        <td>@p.Payment_Date.ToString("yyyy-MM-dd")</td>
                        <td>@p.Vendor_ID</td>
                        <td>@p.Payment_Method</td>
                        <td>@(string.IsNullOrEmpty(p.Reference_Number) ? "" : p.Reference_Number)</td>
                        <td>@p.Amount_Total.ToString("C")</td>
                        <td>@(string.IsNullOrEmpty(p.Notes) ? "" : p.Notes)</td>
                        <td>@p.Created_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@p.Updated_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(p.Deleted_At.HasValue ? p.Deleted_At.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="table-journals" class="table-pane d-none">
        <h4>Journals</h4>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Reference ID</th>
                    <th>Reference Type</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Deleted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model.Journals)
                {
                    <tr>
                        <td>@j.Journal_ID</td>
                        <td>@j.Journal_Type</td>
                        <td>@j.Reference_ID</td>
                        <td>@(string.IsNullOrEmpty(j.Reference_Type) ? "" : j.Reference_Type)</td>
                        <td>@j.Journal_Date.ToString("yyyy-MM-dd")</td>
                        <td>@j.Description</td>
                        <td>@j.Created_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@j.Updated_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(j.Deleted_At.HasValue ? j.Deleted_At.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="table-journallines" class="table-pane d-none">
    <h4>Journal Lines</h4>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Line ID</th>
                <th>Journal ID</th>
                <th>Account Code</th>
                <th>Description</th>
                <th>Debit</th>
                <th>Credit</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jl in Model.JournalLines)
            {
                <tr>
                    <td>@jl.Line_ID</td>
                    <td>@jl.Journal_ID</td>
                    <td>@(string.IsNullOrEmpty(jl.Account_Code) ? "" : jl.Account_Code)</td>
                    <td>@jl.Description</td>
                    <td>@jl.Debit.ToString("C")</td>
                    <td>@jl.Credit.ToString("C")</td>
                    <td>@jl.Created_At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const toggles = document.querySelectorAll('.table-toggle');
            function hideAll() {
                document.querySelectorAll('.table-pane').forEach(el => el.classList.add('d-none'));
            }
            toggles.forEach(btn => {
                btn.addEventListener('click', function () {
                    hideAll();
                    const target = document.querySelector(this.getAttribute('data-target'));
                    if (target) {
                        target.classList.remove('d-none');
                        // scroll to the table for convenience
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });
        })();
    </script>
}